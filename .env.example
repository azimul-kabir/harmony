APP_NAME=Harmony
WEB_AUTH_ENABLED=true
# Protect the web UI and API. Use a long, unique password. The username
# defaults to admin. Enable secure cookies when Harmony is served over HTTPS.
WEB_AUTH_USERNAME=admin
WEB_AUTH_PASSWORD=
WEB_AUTH_SESSION_HOURS=12
WEB_AUTH_SECURE_COOKIE=false

# Host music paths used by docker-compose.yml.
MUSIC_HOST_PATH=./music
DOWNLOAD_HOST_PATH=./downloads

COVER_ART_ARCHIVE_BASE_URL=https://coverartarchive.org
COVER_ART_ARCHIVE_TIMEOUT_SECONDS=20
COVER_ART_ARCHIVE_MAX_BYTES=15728640
APP_VERSION=3.0.0

HOST=0.0.0.0
PORT=8080

DATABASE_URL=sqlite:////database/harmony.db

MUSIC_PATH=/music
ARTWORK_CACHE_PATH=/database/artwork

DOWNLOAD_PATH=/downloads
STAGING_PATH=/downloads/staging
FAILED_PATH=/downloads/failed

LOG_LEVEL=INFO

SPOTDL_PATH=spotdl
# Whole-acquisition budget for the single SpotDL rescue attempt after direct
# yt-dlp acquisition fails. Timeouts are terminal for that job attempt.
SPOTDL_FALLBACK_TIMEOUT_SECONDS=45
SPOTIFY_PLAYLIST_METADATA_TIMEOUT_SECONDS=3600
YT_DLP_PATH=yt-dlp
# Optional Netscape-format YouTube cookies file inside the container. Keep the
# host file private and mount it read-only; see docs/configuration.md.
YT_DLP_COOKIE_FILE=
YOUTUBE_MUSIC_ENABLED=true
YOUTUBE_MUSIC_TIMEOUT_SECONDS=300
YOUTUBE_MUSIC_AUDIO_QUALITY=0
YOUTUBE_MUSIC_MAX_PLAYLIST_ITEMS=500
YOUTUBE_MUSIC_MAX_SEARCH_RESULTS=25
YOUTUBE_MUSIC_MAX_QUEUE_ITEMS=500

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
AUDIO_PROVIDERS=youtube-music,youtube

MAX_PARALLEL_DOWNLOADS=4

LIBRARY_WATCHER_ENABLED=true
LIBRARY_WATCHER_DEBOUNCE_SECONDS=0.75

# Navidrome must be reachable from inside the Harmony container.
NAVIDROME_URL=http://navidrome:4533
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
NAVIDROME_TIMEOUT_SECONDS=5
NAVIDROME_MAX_RETRIES=2
# After a playlist task finishes, scan new audio and reconcile its playlist.
NAVIDROME_PLAYLIST_REIMPORT_ENABLED=true
NAVIDROME_PLAYLIST_REIMPORT_DEBOUNCE_SECONDS=10
NAVIDROME_PLAYLIST_REIMPORT_POLL_SECONDS=2
NAVIDROME_PLAYLIST_REIMPORT_SCAN_TIMEOUT_SECONDS=900
