APP_NAME=Harmony
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
MUSICBRAINZ_USER_AGENT=Harmony/2.0.1 (https://github.com/azimul-kabir/harmony)
MUSICBRAINZ_TIMEOUT_SECONDS=10
MUSICBRAINZ_MAX_RETRIES=3
MUSICBRAINZ_BACKOFF_SECONDS=0.5
MUSICBRAINZ_REQUESTS_PER_SECOND=1
MUSICBRAINZ_CACHE_TTL_SECONDS=86400
MUSICBRAINZ_MAX_CONCURRENT_REQUESTS=2
COVER_ART_ARCHIVE_BASE_URL=https://coverartarchive.org
COVER_ART_ARCHIVE_TIMEOUT_SECONDS=20
COVER_ART_ARCHIVE_MAX_BYTES=15728640
APP_VERSION=2.0.1

HOST=0.0.0.0
PORT=8080

# Host directories mounted by docker-compose.yml. These are the only paths in
# this file that refer to the Docker host; application paths below are inside
# the container.
MUSIC_HOST_PATH=/volume1/music/library
DOWNLOAD_HOST_PATH=/volume1/music/incoming

# Authentication remains off after upgrade to prevent accidental lockout.
AUTH_ENABLED=false
AUTH_BOOTSTRAP_USERNAME=admin
# Prefer *_FILE. Never define a direct value and its *_FILE together.
AUTH_BOOTSTRAP_PASSWORD_FILE=/run/secrets/harmony_admin_password
AUTH_BOOTSTRAP_PASSWORD=
AUTH_SESSION_SECRET_FILE=/run/secrets/harmony_session_secret
AUTH_SESSION_SECRET=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_ABSOLUTE_HOURS=12
AUTH_SESSION_IDLE_MINUTES=60
# Comma-separated immediate proxy socket addresses; empty trusts no proxy.
AUTH_TRUSTED_PROXIES=
# Deprecated and ignored: WEB_AUTH_USERNAME, WEB_AUTH_PASSWORD,
# WEB_AUTH_SESSION_HOURS, WEB_AUTH_SECURE_COOKIE.

DATABASE_URL=sqlite:////database/harmony.db

MUSIC_PATH=/music
ARTWORK_CACHE_PATH=/database/artwork

DOWNLOAD_PATH=/downloads
STAGING_PATH=/downloads/staging
FAILED_PATH=/downloads/failed

LOG_LEVEL=INFO

SPOTDL_PATH=spotdl
SPOTIFY_PLAYLIST_METADATA_TIMEOUT_SECONDS=3600
YT_DLP_PATH=yt-dlp
YOUTUBE_MUSIC_ENABLED=true
DEFAULT_DOWNLOAD_SOURCE=spotify
YOUTUBE_MUSIC_TIMEOUT_SECONDS=300
YOUTUBE_MUSIC_AUDIO_QUALITY=0
YOUTUBE_MUSIC_MAX_PLAYLIST_ITEMS=500
YOUTUBE_MUSIC_MAX_SEARCH_RESULTS=25
YOUTUBE_MUSIC_MAX_QUEUE_ITEMS=500

USE_OFFICIAL_SPOTIFY_API=false
SPOTIFY_METADATA_PROVIDER=spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_GENRE_ENRICHMENT_ENABLED=false
SPOTIFY_GENRE_MAX_VALUES=3
SPOTIFY_GENRE_INCLUDE_FEATURED_FALLBACK=true
SPOTIFY_GENRE_MERGE_FEATURED=false
SPOTIFY_GENRE_REPLACE_EXISTING=false

AUDIO_PROVIDERS=youtube-music,youtube

MAX_PARALLEL_DOWNLOADS=4

LIBRARY_WATCHER_ENABLED=true
LIBRARY_WATCHER_DEBOUNCE_SECONDS=0.75

# Navidrome must be reachable from inside the Harmony container.
NAVIDROME_URL=http://navidrome:4533
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
NAVIDROME_TIMEOUT_SECONDS=5
# Replace Navidrome playlists directly through its Subsonic API and preserve
# Harmony's source order. M3U import remains the automatic fallback.
NAVIDROME_DIRECT_PLAYLIST_SYNC_ENABLED=true
NAVIDROME_DIRECT_SEARCH_LIMIT=25
NAVIDROME_DIRECT_DURATION_TOLERANCE_SECONDS=5
# After a playlist task finishes, scan new audio and reconcile its playlist.
NAVIDROME_PLAYLIST_REIMPORT_ENABLED=true
NAVIDROME_PLAYLIST_REIMPORT_DEBOUNCE_SECONDS=10
NAVIDROME_PLAYLIST_REIMPORT_POLL_SECONDS=2
NAVIDROME_PLAYLIST_REIMPORT_SCAN_TIMEOUT_SECONDS=900

# Optional Synology DSM SNMP v2c monitoring. The community is read only by the
# server and is never included in monitoring responses or logs.
SYNOLOGY_MONITORING_ENABLED=false
SYNOLOGY_SNMP_HOST=
SYNOLOGY_SNMP_PORT=161
SYNOLOGY_SNMP_COMMUNITY=
SYNOLOGY_SNMP_TIMEOUT_SECONDS=2
SYNOLOGY_SNMP_RETRIES=1
SYNOLOGY_METRICS_INTERVAL_SECONDS=30
SYNOLOGY_METRICS_STALE_SECONDS=120
SYNOLOGY_DISK_MAX_INDEX=15
